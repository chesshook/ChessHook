{
  "name": "ChessHook Stockfish 19",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "ChessHook Stockfish API",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash ./codespace.sh",
  "postStartCommand": "bash ./codespace-start.sh"
}
